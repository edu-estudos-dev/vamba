{
  "name": "vamba",
  "version": "0.0.0",
  "private": true,
  "description": "Mobile AI travel companion for Brazilian travelers abroad.",
  "workspaces": [
    "mobile",
    "server"
  ],
  "scripts": {
    "dev": "concurrently --names server,mobile --prefix-colors green,cyan --kill-others \"npm:dev:server\" \"npm:dev:web\"",
    "dev:mobile": "npm --workspace mobile run start",
    "dev:web": "npm --workspace mobile run web",
    "dev:server": "npm --workspace server run dev",
    "build:server": "npm --workspace server run build",
    "start:server": "npm --workspace server run start",
    "typecheck": "npm --workspace server run typecheck && npm --workspace mobile run typecheck",
    "test": "npm --workspace server test && npm --workspace mobile test",
    "install:all": "npm install"
  },
  "engines": {
    "node": ">=22.13.0 <27",
    "npm": ">=10"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
